---
import Base from '../layouts/Base.astro';
import NotFound from '../components/NotFound.astro';
import Icon from '../components/Icon.astro';
import { t, tn } from '../i18n';
import { getLibraryIndex, getTutorProfile } from '../lib/queries';
import { TRACKS } from '../lib/tracks';

const [tutor, index] = await Promise.all([getTutorProfile(), getLibraryIndex()]);
if (!tutor) Astro.response.status = 404;
else Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');

const paragraphs = (tutor?.bio ?? '')
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
const tracks = [...index.entries()].filter(([, s]) => s.length);
const photo = tutor?.photoKey ? `/${tutor.photoKey}` : null;
---

{
  !tutor ? (
    <Base title={t('notFound.title')} noindex>
      <NotFound />
    </Base>
  ) : (
    <Base title={`${t('about.title')}: ${tutor.name}`} description={tutor.headline || t('site.description')} current="about">
      <div class="wrap pt-5 md:pt-8">
        <section class="panel grid gap-6 p-6 md:grid-cols-[auto_minmax(0,1fr)] md:gap-10 md:p-10">
          {photo ? (
            <img src={photo} alt={tutor.name} width="200" height="200" class="size-28 rounded-2xl object-cover ring-1 ring-line md:size-44" />
          ) : null}
          <div class="min-w-0">
            <p class="eyebrow">{t('about.title')}</p>
            <h1 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">{tutor.name}</h1>
            {tutor.headline && <p class="mt-1 text-lg text-ink-2">{tutor.headline}</p>}
            <div class="mt-6 max-w-[68ch] space-y-4 text-ink-2">
              {paragraphs.map((p) => (
                <p class="whitespace-pre-line">{p}</p>
              ))}
            </div>
          </div>
        </section>

        {tracks.length > 0 && (
          <section class="mt-10" aria-labelledby="teaches">
            <h2 id="teaches" class="text-xl font-bold tracking-tight">
              {t('about.teaches')}
            </h2>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {tracks.flatMap(([track, subjects]) =>
                subjects.map((s) => (
                  <li>
                    <a href={`/${track}/${s.slug}`} class="panel group flex items-center gap-3 p-4 text-ink no-underline hover:border-line-strong">
                      <span class="min-w-0 flex-1">
                        <span class="block text-xs font-semibold text-ink-3">{TRACKS[track].label}</span>
                        <span class="block font-bold">{s.name}</span>
                      </span>
                      <span class="text-sm text-ink-3 tabular-nums">{tn('home.lessonsOne', 'home.lessons', s.lessonCount)}</span>
                      <Icon name="chevron-right" size={16} class="text-ink-3 transition-transform group-hover:translate-x-0.5" />
                    </a>
                  </li>
                )),
              )}
            </ul>
          </section>
        )}
      </div>
    </Base>
  )
}
