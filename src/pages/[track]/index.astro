---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import SubjectIndex from '../../components/SubjectIndex.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { t } from '../../i18n';
import { getLibraryIndex } from '../../lib/queries';
import { isTrackId, TRACKS } from '../../lib/tracks';

const { track } = Astro.params;
const valid = isTrackId(track);
const subjects = valid ? (await getLibraryIndex()).get(track) ?? [] : [];
if (!valid) Astro.response.status = 404;
else Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=600');
---

{
  !valid ? (
    <Base title={t('notFound.title')} noindex>
      <NotFound />
    </Base>
  ) : (
    <Base title={TRACKS[track].label} description={`${TRACKS[track].label}: ${TRACKS[track].blurb}. ${t('site.footer')}`} ogImage={`/og/${track}.png`}>
      <div class="wrap pt-6 md:pt-10">
        <Breadcrumb items={[{ label: t('site.name'), href: '/' }]} />
        <h1 class="mt-3 text-2xl font-bold tracking-tight md:text-3xl">{TRACKS[track].label}</h1>
        <p class="mt-1 text-ink-2">{TRACKS[track].blurb}</p>
        <div class="mt-8 max-w-3xl">
          {subjects.length ? <SubjectIndex subjects={subjects} /> : <p class="border-t border-line pt-6 text-ink-2">{t('track.emptyBody')}</p>}
        </div>
      </div>
    </Base>
  )
}
