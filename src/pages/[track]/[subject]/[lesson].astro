---
import Base from '../../../layouts/Base.astro';
import LessonView from '../../../components/LessonView.astro';
import NotFound from '../../../components/NotFound.astro';
import { t, tn } from '../../../i18n';
import { getCourse, getLessonDetail, getTutorProfile } from '../../../lib/queries';
import { trackOgImage } from '../../../lib/tracks';
import { thumbnailUrl } from '../../../lib/youtube';

const track = Astro.params.track ?? '';
const { subject: subjectSlug = '', lesson: lessonSlug = '' } = Astro.params;

const course = await getCourse(track, subjectSlug);
// A course with no public lessons is not public; the subject 404 handles that with context.
if (!course) return Astro.rewrite(`/${track}/${subjectSlug}`);

const [found, tutor] = await Promise.all([getLessonDetail({ subjectId: course.subject.id, slug: lessonSlug }), getTutorProfile()]);
const visible = found && found.detail.status === 'published' && !found.chapterArchived;
if (!visible) Astro.response.status = 404;
else Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=600');

const lesson = visible ? found.detail : null;
const description = lesson?.description.trim().slice(0, 155) || `${lesson?.title} · ${course.subject.name}`;
const ogImage = lesson?.youtubeId && lesson.videoStatus !== 'unavailable' ? thumbnailUrl(lesson.youtubeId, 'hq') : trackOgImage(track);
---

{
  lesson ? (
    <Base current={track} title={`${lesson.title} · ${course.subject.name}`} description={description} ogImage={ogImage} preconnectYouTube={!!lesson.youtubeId}>
      <LessonView track={track} trackLabel={course.subject.trackLabel} subject={course.subject} lesson={lesson} course={course} tutor={tutor} />
    </Base>
  ) : (
    <Base title={t('notFound.lessonTitle')} noindex>
      <NotFound title={t('notFound.lessonTitle')} body={t('notFound.lessonBody', { subject: course.subject.name })}>
        <div class="mt-10 max-w-3xl">
          {course.chapters.map((chapter) => (
            <section class="border-t border-line py-4">
              <h2 class="font-bold">
                <span class="eyebrow mr-2">{t('course.chapter', { n: chapter.number })}</span>
                {chapter.name}
              </h2>
              <ol class="mt-2">
                {chapter.lessons.map((l) => (
                  <li>
                    <a href={`/${track}/${course.subject.slug}/${l.slug}`} class="flex gap-3 rounded py-1.5 text-ink no-underline hover:underline hover:underline-offset-4">
                      <span class="w-6 text-right text-sm text-ink-3 tabular-nums">{l.number}</span>
                      {l.title}
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
          <p class="mt-2 text-sm text-ink-3">{tn('home.lessonsOne', 'home.lessons', course.lessonCount)}</p>
        </div>
      </NotFound>
    </Base>
  )
}
