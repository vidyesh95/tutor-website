---
// Shared by the public lesson page and the admin draft preview, so a preview is exactly what students get.
import type { TutorProfile } from '../db/schema';
import Breadcrumb from './Breadcrumb.astro';
import CourseMemory from './CourseMemory.astro';
import Icon from './Icon.astro';
import TutorCard from './TutorCard.astro';
import VideoFacade from './VideoFacade.astro';
import DownloadPanel from './DownloadPanel.astro';
import { t } from '../i18n';
import { fileUrl, formatBytes } from '../lib/files';
import type { Course, LessonDetail } from '../lib/queries';
import { TRACKS, type TrackId } from '../lib/tracks';

interface Props {
  track: TrackId;
  subject: { id: number; name: string; slug: string };
  lesson: LessonDetail;
  course: Course | null;
  tutor?: TutorProfile | null;
  preview?: boolean;
}
const { track, subject, lesson, course, tutor = null, preview = false } = Astro.props;

const base = `/${track}/${subject.slug}`;
const trackLabel = TRACKS[track].label;
const flat = course?.chapters.flatMap((c) => c.lessons.map((l) => ({ ...l, chapter: c }))) ?? [];
const index = flat.findIndex((l) => l.id === lesson.id);
const here = index >= 0 ? flat[index] : null;
const prev = index > 0 ? flat[index - 1] : null;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : null;
const chapterLessons = here?.chapter.lessons ?? [];

const playable = !!lesson.youtubeId && lesson.videoStatus !== 'unavailable';
const unavailable = !!lesson.youtubeId && lesson.videoStatus === 'unavailable';
// Fixed order: video, primary notes, supplementary. Without a playable video the notes take the hero slot.
const primaryFile = lesson.files.find((f) => f.kind === 'notes') ?? lesson.files[0] ?? null;
const heroFile = playable ? null : primaryFile;
const panelFiles = heroFile ? lesson.files.filter((f) => f !== heroFile) : lesson.files;
const paragraphs = lesson.description
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
const updated = new Date(`${lesson.updatedAt.replace(' ', 'T')}Z`).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const pad = (n: number) => String(n).padStart(2, '0');
---

{
  preview && (
    <div class="border-b border-warn bg-warn-wash no-print">
      <div class="wrap flex min-h-12 flex-wrap items-center justify-between gap-2 py-2 text-sm">
        <p class="font-semibold">{lesson.status === 'draft' ? t('lesson.draftBanner') : t('admin.publishedStatus')}</p>
        <a href={`/admin/lessons/${lesson.id}`} class="btn btn-sm">
          <Icon name="pencil" size={16} />
          {t('lesson.editLesson')}
        </a>
      </div>
    </div>
  )
}

<article class="wrap pt-5 md:pt-8">
  <Breadcrumb items={[{ label: trackLabel, href: `/${track}` }, { label: subject.name, href: base }]} />
  <header class="mt-3">
    <h1 class="max-w-4xl text-2xl font-bold tracking-tight md:text-3xl">{lesson.title}</h1>
    <ul class="mt-3 flex flex-wrap items-center gap-2">
      <li class="chip-static bg-ink text-bg">{trackLabel}</li>
      {here ? <li class="chip-static">{t('lesson.chapterLesson', { chapter: here.chapter.number, lesson: here.number })}</li> : <li class="chip-static">{lesson.chapter.name}</li>}
      {playable && (
        <li class="chip-static">
          <Icon name="video" size={13} />
          {t('course.hasVideo')}
        </li>
      )}
      {lesson.files.length > 0 && (
        <li class="chip-static">
          <Icon name="file" size={13} />
          {lesson.files.length === 1 ? '1 PDF' : `${lesson.files.length} PDFs`}
        </li>
      )}
      <li class="text-xs text-ink-3">{t('lesson.updated', { date: updated })}</li>
    </ul>
  </header>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_21rem] lg:gap-8">
    <div class="min-w-0">
      {
        playable && (
          <div class="-mx-4 md:mx-0">
            <VideoFacade youtubeId={lesson.youtubeId!} title={lesson.title} />
          </div>
        )
      }

      {
        unavailable && (
          <div class="notice notice-warn mb-4" role="note">
            <Icon name="alert" class="mt-0.5 shrink-0" />
            <p>
              {t('lesson.videoUnavailable')}{' '}
              <a href={`https://www.youtube.com/watch?v=${lesson.youtubeId}`} class="font-semibold text-ink underline underline-offset-4" rel="noopener">
                {t('lesson.watchOnYouTube')}
              </a>
            </p>
          </div>
        )
      }

      {
        heroFile && (
          <section class="panel notes-hero p-5 md:p-8" aria-labelledby="notes-hero-heading">
            <div class="flex items-start gap-4">
              <span class="grid size-14 shrink-0 place-items-center rounded-xl bg-bg text-ink-2 shadow-sm ring-1 ring-line">
                <Icon name="file" size={26} />
              </span>
              <div class="min-w-0">
                <h2 id="notes-hero-heading" class="text-xl font-bold">
                  {t('lesson.notesHero')}
                </h2>
                <p class="print-url text-sm text-ink-3" data-url={fileUrl(heroFile.r2Key)}>
                  {t(`fileKinds.${heroFile.kind}`)} · PDF · {formatBytes(heroFile.sizeBytes)}
                </p>
              </div>
            </div>
            <div class="mt-6 flex flex-wrap gap-2 no-print">
              <a href={`${fileUrl(heroFile.r2Key)}?download=1`} download class="btn btn-primary">
                <Icon name="download" size={18} />
                {t('lesson.downloadSized', { size: formatBytes(heroFile.sizeBytes) })}
              </a>
              <a href={fileUrl(heroFile.r2Key)} target="_blank" rel="noopener" class="btn">
                {t('lesson.open')}
                <Icon name="external" size={16} />
              </a>
            </div>
          </section>
        )
      }

      <div class="mt-4 lg:hidden">
        <DownloadPanel files={panelFiles} primaryFile={primaryFile} playable={playable} id="files-main" />
      </div>

      <div class="panel mt-4 flex flex-wrap items-center gap-2 p-3 no-print">
        <button type="button" class="btn mark-done" data-lesson={lesson.id} aria-pressed="false" data-on={t('lesson.markedDone')} data-off={t('lesson.markDone')}>
          <span class="done-mark"><Icon name="check" /></span>
          <span class="mark-label">{t('lesson.markDone')}</span>
        </button>
        <script is:inline define:vars={{ id: lesson.id }}>
          (function () {
            var b = document.currentScript.previousElementSibling;
            if (TL.done().has(id)) {
              b.setAttribute('aria-pressed', 'true');
              b.setAttribute('data-done', '');
              b.querySelector('.mark-label').textContent = b.dataset.on;
            }
          })();
        </script>
        <button type="button" class="btn btn-quiet share-btn" data-copied={t('lesson.linkCopied')} hidden>
          <Icon name="share" size={16} />
          <span class="share-label">{t('lesson.share')}</span>
        </button>
        {
          lesson.youtubeId && (
            <a href={`https://www.youtube.com/watch?v=${lesson.youtubeId}`} rel="noopener" target="_blank" class="btn btn-quiet">
              <Icon name="video" size={16} />
              YouTube
            </a>
          )
        }
      </div>

      {
        paragraphs.length > 0 && (
          <section class="panel mt-4 p-5 md:p-8" aria-labelledby="about-heading">
            <h2 id="about-heading" class="eyebrow">
              {t('lesson.about')}
            </h2>
            <div class="mt-3 max-w-[68ch] space-y-4 text-ink-2">
              {paragraphs.map((p) => (
                <p class="whitespace-pre-line">{p}</p>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <aside class="grid content-start gap-4">
      <div class="hidden lg:block">
        <DownloadPanel files={panelFiles} primaryFile={primaryFile} playable={playable} id="files-aside" />
      </div>

      {
        here && (
          <nav class="panel p-5 no-print" aria-labelledby="chapter-nav-heading">
            <div class="flex items-baseline justify-between gap-3">
              <h2 id="chapter-nav-heading" class="eyebrow">
                {t('course.chapter', { n: here.chapter.number })}
              </h2>
              <span class="text-xs text-ink-3">{chapterLessons.length === 1 ? '1 lesson' : `${chapterLessons.length} lessons`}</span>
            </div>
            <p class="mt-1 font-bold">{here.chapter.name}</p>
            <ol class="mt-3 grid gap-1.5">
              {chapterLessons.map((l) => (
                <li data-lesson-id={l.id}>
                  <a
                    href={`${base}/${l.slug}`}
                    aria-current={l.id === lesson.id ? 'page' : undefined}
                    class="outline-row flex min-h-12 items-center gap-3 rounded-xl border border-transparent px-3 py-2 text-sm text-ink-2 no-underline hover:bg-surface hover:text-ink"
                  >
                    <span class="done-mark scale-90" aria-hidden="true">
                      <Icon name="check" />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="now-label block text-xs font-semibold text-ink-3">
                        {t('course.lessonN', { n: pad(l.number) })}
                        <span class="now-playing"> · {playable ? t('lesson.nowPlaying') : t('lesson.youAreHere')}</span>
                      </span>
                      <span class="block leading-snug">{l.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
            <script is:inline>
              (function () {
                var done = TL.done();
                document.currentScript.parentElement.querySelectorAll('[data-lesson-id]').forEach(function (li) {
                  if (done.has(Number(li.dataset.lessonId))) li.setAttribute('data-done', '');
                });
              })();
            </script>
            <div class="mt-4 grid grid-cols-2 gap-2">
              {prev ? (
                <a href={`${base}/${prev.slug}`} class="btn btn-sm" aria-label={`${t('lesson.previous')}: ${prev.title}`}>
                  <Icon name="arrow-left" size={16} />
                  {t('lesson.previous')}
                </a>
              ) : (
                <a href={base} class="btn btn-sm">
                  <Icon name="arrow-left" size={16} />
                  {t('lesson.allLessons')}
                </a>
              )}
              {next ? (
                <a href={`${base}/${next.slug}`} class="btn btn-ink btn-sm" aria-label={`${t('lesson.next')}: ${next.title}`}>
                  {t('lesson.next')}
                  <Icon name="arrow-right" size={16} />
                </a>
              ) : (
                <a href={base} class="btn btn-sm">
                  {t('lesson.allLessons')}
                </a>
              )}
            </div>
          </nav>
        )
      }

      {
        tutor && (
          <section class="panel p-5">
            <TutorCard tutor={tutor} variant="compact" />
          </section>
        )
      }
    </aside>
  </div>
</article>

{
  here && (
    <div class="sticky-bar sticky bottom-0 z-10 mt-10 border-t border-line bg-bg sm:hidden no-print">
      <div class="wrap flex items-center gap-2 py-2">
        {prev ? (
          <a href={`${base}/${prev.slug}`} class="btn btn-sm" aria-label={`${t('lesson.previous')}: ${prev.title}`}>
            <Icon name="arrow-left" size={18} />
          </a>
        ) : (
          <a href={base} class="btn btn-sm" aria-label={t('lesson.backToCourse', { subject: subject.name })}>
            <Icon name="arrow-left" size={18} />
          </a>
        )}
        {next ? (
          <a href={`${base}/${next.slug}`} class="btn btn-ink btn-sm min-w-0 flex-1 justify-between">
            <span class="truncate">{t('lesson.nextLesson', { title: next.title })}</span>
            <Icon name="arrow-right" size={18} class="shrink-0" />
          </a>
        ) : (
          <a href={base} class="btn btn-sm min-w-0 flex-1">
            <span class="truncate">{t('lesson.backToCourse', { subject: subject.name })}</span>
          </a>
        )}
      </div>
    </div>
  )
}

{!preview && course && <CourseMemory course={course} openedLessonId={lesson.id} />}

<script>
  type TLApi = { read: (k: string, d: unknown) => unknown; write: (k: string, v: unknown) => void };
  const TL = (window as unknown as { TL: TLApi }).TL;

  for (const button of document.querySelectorAll<HTMLButtonElement>('.mark-done')) {
    const id = Number(button.dataset.lesson);
    button.addEventListener('click', () => {
      const done = new Set(TL.read('tl:done', []) as number[]);
      const nowDone = !done.has(id);
      if (nowDone) done.add(id);
      else done.delete(id);
      TL.write('tl:done', [...done]);
      button.toggleAttribute('data-done', nowDone);
      button.setAttribute('aria-pressed', String(nowDone));
      button.querySelector('.mark-label')!.textContent = nowDone ? button.dataset.on! : button.dataset.off!;
      document.querySelectorAll(`aside [data-lesson-id="${id}"]`).forEach((el) => el.toggleAttribute('data-done', nowDone));
    });
  }

  // Share: native sheet on phones, copy-link elsewhere. Hidden entirely without JS.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.share-btn')) {
    button.hidden = false;
    const label = button.querySelector('.share-label')!;
    const original = label.textContent;
    button.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else {
          await navigator.clipboard.writeText(location.href);
          label.textContent = button.dataset.copied!;
          setTimeout(() => (label.textContent = original), 2000);
        }
      } catch {}
    });
  }
</script>

<style>
  .sticky-bar {
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: var(--shadow-sticky);
  }
  .notes-hero {
    background: var(--surface);
  }
  .outline-row[aria-current='page'] {
    background: var(--accent-wash);
    border-color: var(--accent-stroke);
    color: var(--ink);
    font-weight: 600;
  }
  .now-playing {
    display: none;
  }
  .outline-row[aria-current='page'] .now-playing {
    display: inline;
  }
  .outline-row[aria-current='page'] .now-label {
    color: var(--ink-2);
  }
  .mark-done .done-mark {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
