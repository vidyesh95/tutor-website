---
import Icon from './Icon.astro';

interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="-ml-0.5 flex flex-wrap items-center gap-x-1 gap-y-0.5 text-ink-3">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <Icon name="chevron-right" size={14} />}
          <a href={item.href} class="rounded px-0.5 py-1 text-ink-2 no-underline hover:text-ink hover:underline hover:underline-offset-4">
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
