---
// One small POST form per admin control, so everything works without JS.
interface Props {
  action: string;
  fields?: Record<string, string | number>;
  /** Fragment to return to after the redirect (browsers carry it across the 303). */
  anchor?: string;
  class?: string;
}
const { action, fields = {}, anchor, class: className } = Astro.props;
---

<form method="POST" action={anchor ? `${action}#${anchor}` : action} class={className}>
  {Object.entries(fields).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
  <slot />
</form>
