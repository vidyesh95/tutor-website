---
// Table-of-contents style list of subjects: name, dotted leader, counts.
import { tn } from '../i18n';
import type { SubjectSummary } from '../lib/queries';
import Icon from './Icon.astro';

interface Props {
  subjects: SubjectSummary[];
}
const { subjects } = Astro.props;
---

<ul class="divide-y divide-line border-y border-line">
  {
    subjects.map((s) => (
      <li>
        <a
          href={`/${s.track}/${s.slug}`}
          class="group flex min-h-14 items-center gap-3 py-3 text-ink no-underline transition-colors duration-150 hover:bg-surface md:-mx-3 md:px-3"
        >
          <span class="min-w-0">
            <span class="block text-lg leading-snug font-semibold">{s.name}</span>
            <span class="block text-sm text-ink-3">{tn('home.chaptersOne', 'home.chapters', s.chapterCount)}</span>
          </span>
          <span aria-hidden="true" class="leader mb-1.5 hidden flex-1 self-end sm:block" />
          <span class="ml-auto shrink-0 text-sm text-ink-2 tabular-nums sm:ml-0">
            {tn('home.lessonsOne', 'home.lessons', s.lessonCount)}
          </span>
          <Icon
            name="chevron-right"
            size={18}
            class="shrink-0 text-ink-3 transition-transform duration-150 group-hover:translate-x-0.5"
          />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .leader {
    border-bottom: 2px dotted var(--line-strong);
    min-width: 2rem;
  }
</style>
