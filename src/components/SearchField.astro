---
import { t } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  value?: string;
  track?: string;
  subjectId?: number;
  autofocus?: boolean;
  placeholder?: string;
  compact?: boolean;
  id?: string;
}
const { value = '', track, subjectId, autofocus = false, id = 'q', placeholder = t('search.placeholder'), compact = false } = Astro.props;
---

<form action="/search" method="get" role="search" class="search-field flex gap-2" data-search-form>
  <label for={id} class="sr-only">{t('search.label')}</label>
  <div class="relative flex-1">
    <Icon name="search" class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-ink-3" />
    <input
      id={id}
      name="q"
      type="search"
      value={value}
      autocomplete="off"
      enterkeyhint="search"
      spellcheck="false"
      placeholder={placeholder}
      autofocus={autofocus}
      class:list={['input rounded-xl pl-12 shadow-[0_1px_0_var(--line)]', compact ? 'min-h-11 text-sm' : 'min-h-13 text-base']}
    />
  </div>
  {track && <input type="hidden" name="track" value={track} />}
  {subjectId && <input type="hidden" name="subject" value={subjectId} />}
  {!compact && <button type="submit" class="btn min-h-13 rounded-xl px-5">{t('search.submit')}</button>}
</form>
