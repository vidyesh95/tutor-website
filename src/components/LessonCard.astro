---
// One lesson as a card: thumbnail (or a ruled-paper tile for notes-only lessons), context, and
// two actions. The title link stretches over the card; the PDF button sits above it.
import { t } from '../i18n';
import { fileUrl, formatBytes } from '../lib/files';
import type { LessonCard } from '../lib/queries';
import { thumbnailUrl } from '../lib/youtube';
import Icon from './Icon.astro';

interface Props {
  lesson: LessonCard;
}
const { lesson } = Astro.props;
const href = `/${lesson.track}/${lesson.subjectSlug}/${lesson.slug}`;
const kinds = lesson.kinds.map((k) => t(`fileKinds.${k}`)).join(' · ');
---

<article class="lesson-card panel group relative flex flex-col overflow-hidden" data-lesson-id={lesson.id}>
  <div class="relative aspect-video overflow-hidden border-b border-line bg-surface-2">
    {
      lesson.youtubeId ? (
        <>
          <img
            src={thumbnailUrl(lesson.youtubeId, 'mq')}
            srcset={`${thumbnailUrl(lesson.youtubeId, 'mq')} 320w, ${thumbnailUrl(lesson.youtubeId, 'hq')} 480w`}
            sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 100vw"
            width="320"
            height="180"
            alt=""
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
          />
          <span class="absolute inset-0 grid place-items-center" aria-hidden="true">
            <span class="grid size-11 place-items-center rounded-full bg-bg/90 text-ink shadow-sm transition-transform duration-200 group-hover:scale-110">
              <Icon name="play" size={18} class="translate-x-px" />
            </span>
          </span>
        </>
      ) : (
        <div class="ruled grid h-full place-items-center" aria-hidden="true">
          <span class="flex items-center gap-2 rounded-lg border border-line bg-bg px-3 py-2 text-sm font-semibold text-ink-2 shadow-sm">
            <Icon name="file" size={18} />
            {kinds || t('fileKinds.notes')}
          </span>
        </div>
      )
    }
    <span class="chip-static absolute top-3 left-3 bg-bg/95 text-ink shadow-sm">{lesson.subjectName}</span>
  </div>

  <div class="flex flex-1 flex-col p-4 md:p-5">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
      <span class="font-semibold text-ink-2">{lesson.trackLabel}</span>
      <span aria-hidden="true">·</span>
      <span class="truncate">{lesson.chapterName}</span>
    </p>
    <h3 class="mt-1.5 text-lg leading-snug font-bold">
      <a href={href} class="stretched text-ink no-underline">{lesson.title}</a>
    </h3>
    {lesson.description && <p class="mt-1.5 line-clamp-2 text-sm text-ink-2">{lesson.description}</p>}

    <div class="mt-auto flex items-center justify-between gap-3 pt-4">
      <span class="flex items-center gap-1 text-sm font-semibold text-ink">
        {lesson.youtubeId ? t('home.watch') : t('home.openLesson')}
        <Icon name="arrow-right" size={16} class="transition-transform duration-150 group-hover:translate-x-0.5" />
      </span>
      {
        lesson.primaryFile && (
          <a
            href={`${fileUrl(lesson.primaryFile.r2Key)}?download=1`}
            download
            class="btn btn-sm relative z-10"
            aria-label={t('lesson.downloadAria', { label: `${t(`fileKinds.${lesson.primaryFile.kind}`)}: ${lesson.title}`, size: formatBytes(lesson.primaryFile.sizeBytes) })}
          >
            <Icon name="download" size={16} />
            PDF <span class="font-normal text-ink-3">{formatBytes(lesson.primaryFile.sizeBytes)}</span>
          </a>
        )
      }
    </div>
  </div>
  <span class="done-flag chip-static absolute top-3 right-3 bg-accent text-accent-ink" hidden>
    <Icon name="check" size={14} />
    {t('course.done')}
  </span>
</article>

<style>
  .lesson-card {
    transition:
      border-color 150ms var(--ease-out-quart),
      transform 200ms var(--ease-out-quart);
  }
  .lesson-card:hover {
    border-color: var(--line-strong);
  }
  .lesson-card:focus-within {
    outline: 2px solid var(--accent-stroke);
    outline-offset: 2px;
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .stretched:focus-visible {
    outline: none;
  }
  /* Notebook paper for lessons that are notes only. */
  .ruled {
    background:
      linear-gradient(to right, transparent 2.25rem, var(--line-strong) 2.25rem, var(--line-strong) calc(2.25rem + 1px), transparent calc(2.25rem + 1px)),
      repeating-linear-gradient(to bottom, var(--surface) 0 1.375rem, var(--line) 1.375rem calc(1.375rem + 1px));
  }
</style>
