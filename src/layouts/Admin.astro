---
import { Font } from 'astro:assets';
import { actions } from 'astro:actions';
import '../styles/global.css';
import { t } from '../i18n';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  /** Login screen shows no navigation. */
  bare?: boolean;
  current?: 'lessons' | 'structure' | 'profile';
}
const { title, bare = false, current } = Astro.props;
const nav = [
  { id: 'lessons', label: t('admin.lessons'), href: '/admin' },
  { id: 'structure', label: t('admin.structure'), href: '/admin/structure' },
  { id: 'profile', label: 'Tutor profile', href: '/admin/profile' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {t('admin.title')}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-atkinson" preload />
    <script is:inline>
      try {
        var saved = localStorage.getItem('tl:theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-ui bg-accent px-4 py-2 font-semibold text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{t('site.skip')}</a
    >
    <header class="border-b border-line bg-surface">
      <div class="wrap flex min-h-14 flex-wrap items-center gap-x-4 gap-y-1 py-2">
        <a href="/admin" class="mr-auto font-bold tracking-tight text-ink no-underline">{t('admin.title')}</a>
        {
          !bare && (
            <>
              <nav aria-label="Admin" class="order-last -mx-1 flex w-full gap-1 overflow-x-auto md:order-none md:w-auto">
                {nav.map((item) => (
                  <a
                    href={item.href}
                    aria-current={current === item.id ? 'page' : undefined}
                    class="admin-nav rounded-ui px-3 py-2 text-sm font-semibold whitespace-nowrap text-ink-2 no-underline hover:bg-surface-2 hover:text-ink"
                  >
                    {item.label}
                  </a>
                ))}
                <a href="/" target="_blank" class="flex items-center gap-1 rounded-ui px-3 py-2 text-sm font-semibold whitespace-nowrap text-ink-2 no-underline hover:bg-surface-2 hover:text-ink">
                  {t('admin.viewSite')}
                  <Icon name="external" size={14} />
                </a>
              </nav>
              <form method="POST" action={'/admin/login' + actions.logoutAdmin}>
                <button class="btn btn-quiet btn-sm">{t('admin.signOut')}</button>
              </form>
            </>
          )
        }
        <ThemeToggle />
      </div>
    </header>
    <main id="main" tabindex="-1" class="wrap flex-1 py-6 outline-none md:py-10">
      <slot />
    </main>
  </body>
</html>

<style>
  .admin-nav[aria-current='page'] {
    background: var(--bg);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
