---
import { Font } from 'astro:assets';
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import { t } from '../i18n';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getTutorProfile } from '../lib/queries';
import { getPublicTracks } from '../lib/track-queries';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  /** Home has its own big search field, so the header one is hidden there. */
  headerSearch?: boolean;
  preconnectYouTube?: boolean;
  /** Highlights the matching header link. */
  current?: string;
}

const {
  title,
  description = t('site.description'),
  ogImage = '/og/default.png',
  canonical,
  noindex = false,
  headerSearch = true,
  preconnectYouTube = false,
  current,
} = Astro.props;
const [tutor, publicTracks] = await Promise.all([getTutorProfile(), getPublicTracks()]);
const nav = [
  ...publicTracks.map((t) => ({ id: t.slug, label: t.label, href: `/${t.slug}` })),
  ...(tutor ? [{ id: 'about', label: t('about.nav'), href: '/about' }] : []),
];

const siteName = t('site.name');
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.url.origin).href;
const ogImageUrl = new URL(ogImage, Astro.url.origin).href;
const beaconToken = (env as unknown as Record<string, string | undefined>).CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1b1a17" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    {preconnectYouTube && <link rel="preconnect" href="https://i.ytimg.com" />}
    <Font cssVariable="--font-atkinson" preload />

    <script is:inline>
      try {
        var saved = localStorage.getItem('tl:theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
      // Device-only study memory. Every access is guarded: blocked storage must never break a page.
      // tl:done = [lessonId]; tl:courses = { [subjectId]: { name, track, url, lessons: [[id, title, url]], last, at } }
      window.TL = {
        read: function (k, d) {
          try { var v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch (e) { return d; }
        },
        write: function (k, v) {
          try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {}
        },
        done: function () { return new Set(TL.read('tl:done', [])); },
        // Next not-done lesson at or after the last opened one, wrapping to the start;
        // when the whole course is done, the last opened lesson.
        resume: function (course, done) {
          var ls = course.lessons, n = ls.length, i = 0;
          for (var k = 0; k < n; k++) if (ls[k][0] === course.last) i = k;
          for (var j = 0; j < n; j++) {
            var l = ls[(i + j) % n];
            if (!done.has(l[0])) return { lesson: l, complete: false };
          }
          return n ? { lesson: ls[i], complete: true } : null;
        }
      };
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="skip-link sr-only z-50 rounded-ui bg-accent px-4 py-2 font-semibold text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{t('site.skip')}</a
    >

    <header role="banner" class="border-b border-line bg-bg">
      <div class="wrap flex h-14 items-center gap-3 md:h-16">
        <a href="/" class="-ml-1 flex items-center gap-2.5 rounded px-1 text-ink no-underline">
          <img src="/favicon.svg" alt="" width="28" height="28" class="size-7 rounded-md" />
          <span class="text-base font-bold tracking-tight md:text-lg">{siteName}</span>
        </a>
        <nav aria-label="Tracks" class="ml-6 hidden items-center gap-0.5 lg:flex">
          {
            nav.map((item) => (
              <a href={item.href} class="nav-link" aria-current={current === item.id ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-1">
          {
            headerSearch && (
              <>
                <form action="/search" method="get" role="search" class="relative mr-1 hidden w-60 md:block xl:w-72">
                  <label for="header-q" class="sr-only">
                    {t('search.label')}
                  </label>
                  <Icon name="search" size={18} class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-ink-3" />
                  <input
                    id="header-q"
                    name="q"
                    type="search"
                    autocomplete="off"
                    enterkeyhint="search"
                    placeholder={t('search.label')}
                    class="input min-h-10 bg-canvas pl-9 text-sm"
                  />
                </form>
                <a href="/search" class="btn btn-quiet btn-sm md:hidden" aria-label={t('search.label')}>
                  <Icon name="search" />
                </a>
              </>
            )
          }
          <ThemeToggle />
        </div>
      </div>
      <nav aria-label="Tracks" class="wrap -mt-1 flex gap-1 overflow-x-auto pb-2 lg:hidden">
        {
          nav.map((item) => (
            <a href={item.href} class="nav-link shrink-0" aria-current={current === item.id ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>

    <footer role="contentinfo" class="mt-20 border-t border-line bg-bg">
      <div class="wrap grid gap-8 py-10 md:grid-cols-[minmax(0,1.4fr)_repeat(2,minmax(0,1fr))]">
        <div class="max-w-sm">
          <p class="flex items-center gap-2 font-bold">
            <img src="/favicon.svg" alt="" width="22" height="22" class="size-5.5 rounded" />
            {siteName}
          </p>
          <p class="mt-2 text-sm text-ink-2">{t('site.footerAbout')}</p>
        </div>
        <nav aria-label="Tracks footer">
          <h2 class="eyebrow">{t('site.footerTracks')}</h2>
          <ul class="mt-3 grid gap-2 text-sm">
            {publicTracks.map((t) => <li><a href={`/${t.slug}`} class="footer-link">{t.label}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="Library">
          <h2 class="eyebrow">{t('site.footerLibrary')}</h2>
          <ul class="mt-3 grid gap-2 text-sm">
            <li><a href="/search" class="footer-link">{t('search.title')}</a></li>
            {tutor && <li><a href="/about" class="footer-link">{t('about.nav')}</a></li>}
            <li><a href="/admin" class="footer-link" rel="nofollow">{t('site.tutorSignIn')}</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-line">
        <p class="wrap py-4 text-xs text-ink-3">{siteName}. {t('site.footer')}</p>
      </div>
    </footer>

    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
  </body>
</html>

<style is:global>
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-2);
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 150ms var(--ease-out-quart);
  }
  .nav-link:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .nav-link[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
  }
  .footer-link {
    color: var(--ink-2);
    text-decoration: none;
  }
  .footer-link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
